CREATE EXTENSION rum;
CREATE TABLE test_table (
	id bigint,
	folder bigint,
	time bigint,
	tags int4[]
);
CREATE INDEX test_idx
ON test_table USING rum(folder, tags rum_anyarray_addon_ops, time)
WITH (attach = 'time', to = 'tags', order_by_attach = TRUE);
INSERT INTO test_table (id, folder, time, tags) VALUES
	(1, 10, 100, '{1,10}'),
	(2, 20, 200, '{2,20}'),
	(3, 10, 300, '{1,30}'),
	(4, 20, 400, '{2,40}'),
	(5, 20, 60,  '{2,50}'),
	(6, 10, 40,  '{1,60}'),
	(7, 20, 50,  '{2,70}'),
	(8, 10, 30,  '{1,80}');
EXPLAIN (costs off)
SELECT *
FROM test_table
WHERE tags && '{1}'::int4[]
	AND folder = 10::bigint;
                               QUERY PLAN                               
------------------------------------------------------------------------
 Index Scan using test_idx on test_table
   Index Cond: ((folder = '10'::bigint) AND (tags && '{1}'::integer[]))
(2 rows)

SELECT *
FROM test_table
WHERE tags && '{1}'::int4[]
	AND folder = 10::bigint;
 id | folder | time |  tags  
----+--------+------+--------
  8 |     10 |   30 | {1,80}
  6 |     10 |   40 | {1,60}
  1 |     10 |  100 | {1,10}
  3 |     10 |  300 | {1,30}
(4 rows)

EXPLAIN (costs off)
SELECT *
FROM test_table
WHERE tags && '{1}'::int4[]
	AND folder = 10::bigint
ORDER BY time <=| 500::bigint;
                               QUERY PLAN                               
------------------------------------------------------------------------
 Index Scan using test_idx on test_table
   Index Cond: ((folder = '10'::bigint) AND (tags && '{1}'::integer[]))
   Order By: ("time" <=| '500'::bigint)
(3 rows)

SELECT *
FROM test_table
WHERE tags && '{1}'::int4[]
	AND folder = 10::bigint
ORDER BY time <=| 500::bigint;
 id | folder | time |  tags  
----+--------+------+--------
  3 |     10 |  300 | {1,30}
  1 |     10 |  100 | {1,10}
  6 |     10 |   40 | {1,60}
  8 |     10 |   30 | {1,80}
(4 rows)

